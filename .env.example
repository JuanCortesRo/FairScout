# Plantilla para docker compose. En el servidor se guarda como ~/talentscout.env (fuera del repo)
# y el workflow de despliegue la copia a .env. Nunca subas .env al repositorio.

# LLM
ANTHROPIC_API_KEY=sk-ant-tu-llave-aqui
MODELO_EXTRACCION=claude-haiku-5-5
MODELO_EVALUACION=claude-haiku-5-5
PROMPT_VERSION=v1

# Base de datos (servicio db)
POSTGRES_USER=talent
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=talent
# Debe coincidir con las tres variables anteriores
DATABASE_URL=postgresql+psycopg://talent:cambia-esta-clave@db:5432/talent

# Backend (CORS): la URL pública del frontend
FRONTEND_URL=http://localhost

# Caddy: ":80" para HTTP, o "<ip-con-guiones>.sslip.io" para HTTPS automático
DOMAIN=:80
